# The only public entry of the test environment (W35a plan D-3): HTTPS with a Let's Encrypt certificate for API_HOST,
# plain http redirected to https, every answer proxied to the API.
# No trusted_proxies: Caddy then replaces any X-Forwarded-For, -Proto and -Host a client sends with what it sees, and the
# API trusts those headers from this container's fixed address alone (compose.yaml).
{$API_HOST} {
	header {
		# The test API is never indexed
		X-Robots-Tag "noindex"
		-Server
	}
	reverse_proxy api:8081 {
		# Caddy passes these through unchanged; Tomcat would take the client's X-Forwarded-Port as the server port (a
		# forged one made a cross-origin call look same-origin), and the others are no client's to set
		header_up -X-Forwarded-Port
		header_up -X-Forwarded-Prefix
		header_up -Forwarded
		header_up -X-Real-IP
	}
}
