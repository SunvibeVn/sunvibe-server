{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash 'D:\\aa_sunvibe\\sunvibe-hub\\sunvibe-server\\.codex\\hooks\\protect-migrations.sh'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash 'D:\\aa_sunvibe\\sunvibe-hub\\sunvibe-server\\.codex\\hooks\\format.sh'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash 'D:\\aa_sunvibe\\sunvibe-hub\\sunvibe-server\\.codex\\hooks\\verify-build.sh'",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/../scripts/claude-hooks/docs-reminder.sh\"; if [ -f \"$f\" ]; then bash \"$f\"; fi"
          }
        ]
      }
    ]
  }
}
