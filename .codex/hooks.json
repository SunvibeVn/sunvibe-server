{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; bash \"$r/.claude/hooks/protect-migrations.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; bash \"$r/.claude/hooks/verify-build.sh\"",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; bash \"$r/.claude/hooks/hub-hook.sh\" docs-reminder.sh"
          }
        ]
      }
    ]
  }
}
