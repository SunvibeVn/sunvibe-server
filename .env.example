# Example environment for sunvibe-server. Copy to your shell or IDE run config.
# Fake values only. Never commit real secrets.

# HTTP port of the API (default 8081)
SERVER_PORT=8081
# JDBC URL of the local PostgreSQL database
DB_URL=jdbc:postgresql://localhost:5432/sunvibe
# Database user
DB_USERNAME=sunvibe
# Database password
DB_PASSWORD=change-me
# true = sign-up requires a verified phone number
REGISTRATION_REQUIRE_PHONE_VERIFICATION=true
# SMS provider: none (default) or log (prints OTPs to the log, dev/test only)
SMS_PROVIDER=log
# Phone channel: off (default), legacy-login (phone + password until the date below) or on (local and test)
AUTH_PHONE_MODE=off
# legacy-login only: the end of phone sign-in, an ISO instant at most 60 days ahead
AUTH_PHONE_LEGACY_LOGIN_UNTIL=
# The web app: reset links start with it; it must be an allowed CORS origin, and https in prod
AUTH_FRONTEND_BASE_URL=http://localhost:3000
# Base64 HMAC key (at least 32 bytes) for stored one-time codes; changing it voids codes in flight (generate your own)
AUTH_OTP_HASH_KEY=
# Auth mails per hour and instance; set it below the real limit of the sender
AUTH_MAIL_MAX_PER_HOUR=300
# Mail server and sender; the dev profile needs none of them unless a mail must leave
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=
# Base64 AES key used to encrypt ID card numbers (generate your own)
ID_CARD_CRYPTO_KEY=
# Base64 key used for the ID card blind index (generate your own)
ID_CARD_CRYPTO_INDEX_KEY=
# Base64 HMAC key (at least 32 bytes) for the owner-intake consent IP/user-agent hashes (generate your own)
ACQUISITION_HASH_KEY=
# true = the public owner intake form accepts submissions (default false; the dev profile turns it on)
ACQUISITION_OWNER_INTAKE_ENABLED=false
# Inventory intake (property-create intake A-11): both true stops the start-up
PROPERTY_INTAKE_ENABLED=false
PROPERTY_DIRECT_CREATE_ENABLED=true
# Survey photos (survey-media spec A-1, ADR-002): the Cloudflare R2 token of the media store, read only when
# app.survey.media.store=s3; leave empty in dev (uploads off, or the local store of scripts/dev/run-e2e-media-api.sh)
SURVEY_MEDIA_S3_ACCESS_KEY_ID=
SURVEY_MEDIA_S3_SECRET_ACCESS_KEY=
# Only for the lan profile (dev,lan): the web app origin on the LAN, e.g. http://192.168.1.20:3000
# It must be set for that profile (unset or empty is not supported); unused otherwise.
# See ../docs/setup/lan-device-testing.md
LAN_FE_ORIGIN=
