# Auth mail through Brevo SMTP on staging. A template without secrets: scripts/ops/README.md section 9 explains the mail values.
# Set these in the deployment system. Never commit a filled copy.
# <ref: name> is the name of an entry in the secret store of the environment, not its value.

SPRING_PROFILES_ACTIVE=prod

# SMTP relay; every auth mail goes through it. Unset, MAIL_HOST falls back to another provider, which would get the key.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
# Keep true: it makes TLS mandatory before the login is sent
MAIL_STARTTLS=true
# The sender shown on every mail; it must be a verified Brevo sender. It is not the SMTP login.
MAIL_FROM=services@sunvibe.vn
# The SMTP login of the Brevo account, copied from its SMTP settings page
MAIL_USERNAME=<ref: staging/brevo-smtp-login>
# An SMTP key made for this environment alone; not an API key and not the password of the account
MAIL_PASSWORD=<ref: staging/brevo-smtp-key>
# Per process, an hourly figure
AUTH_MAIL_MAX_PER_HOUR=10

# The staging web app: https, no path, no trailing slash. Reset links start with it.
AUTH_FRONTEND_BASE_URL=https://<frontend-staging>
# The same value as the line above. The profile prod allows only production, so this line must be set; left as written, it
# stops the start-up.
APP_CORS_ALLOWED_ORIGINS=<same value as AUTH_FRONTEND_BASE_URL>

# Same value as NEXT_PUBLIC_AUTH_PHONE_MODE in the web build; legacy-login also needs AUTH_PHONE_LEGACY_LOGIN_UNTIL
AUTH_PHONE_MODE=off

# The rest of what the profile prod needs to start; each key belongs to this environment alone
DB_URL=<ref: staging/db-url>
DB_USERNAME=<ref: staging/db-username>
DB_PASSWORD=<ref: staging/db-password>
JWT_SECRET=<ref: staging/jwt-secret>
AUTH_OTP_HASH_KEY=<ref: staging/otp-hash-key>
ID_CARD_CRYPTO_KEY=<ref: staging/id-card-key>
ID_CARD_CRYPTO_INDEX_KEY=<ref: staging/id-card-index-key>
ACQUISITION_HASH_KEY=<ref: staging/acquisition-hash-key>
