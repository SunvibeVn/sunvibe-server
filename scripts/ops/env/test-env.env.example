# The one-VM test environment (W35a plan Task S2; scripts/ops/README.md "Test environment on one VM"). A template
# without secrets: scripts/ops/test-env/gen-secrets.sh copies it to an env file outside the checkout (mode 600) and fills
# every <generated> value; the owner types the two <owner> values at its hidden prompt. Never commit a filled copy.
# docker/test-env/compose.yaml reads the filled file as --env-file and as the env file of the api service.
# Values are written without quotes and without $, which Compose would expand; the one quoted value below is a literal.

# The filled env file itself (an absolute path outside the checkout), for the api service
API_ENV_FILE=/opt/sunvibe/test.env
# The host Caddy serves and gets a certificate for: an A record to the VM, no AAAA
API_HOST=api-test.sunvibe.vn

SPRING_PROFILES_ACTIVE=prod

# Mail: the separate Brevo account of the test environment (owner decision OD-2), never the production account.
# scripts/ops/README.md section 9 explains these keys.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
# Keep true: it makes TLS mandatory before the login is sent
MAIL_STARTTLS=true
# The sender shown on every mail; it must be a verified sender of the test account. It is not the SMTP login.
MAIL_FROM=services@sunvibe.vn
# The SMTP login of the test account, copied from its SMTP settings page
MAIL_USERNAME=<owner>
# An SMTP key made for this environment alone; not an API key and not the password of the account
MAIL_PASSWORD=<owner>
# Per process, an hourly figure; sign-up is open on this environment (owner decision OD-1)
AUTH_MAIL_MAX_PER_HOUR=10
# The mail server's certificate must name the host connected to (W35a plan D-6, hardening spec 4.5)
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_CHECKSERVERIDENTITY=true

# The test web app: https, no path, no trailing slash. Reset links start with it.
AUTH_FRONTEND_BASE_URL=https://test.sunvibe.vn
# The same value as the line above; the profile prod allows only production otherwise
APP_CORS_ALLOWED_ORIGINS=https://test.sunvibe.vn

# Same value as NEXT_PUBLIC_AUTH_PHONE_MODE in the web build
AUTH_PHONE_MODE=off

# The database container of docker/test-env/compose.yaml. gen-secrets.sh writes one password to both password keys.
DB_URL=jdbc:postgresql://postgres:5432/sunvibe_core
DB_USERNAME=sunvibe
DB_PASSWORD=<generated>
POSTGRES_DB=sunvibe_core
POSTGRES_USER=sunvibe
POSTGRES_PASSWORD=<generated>

# Keys of this environment alone, never reused elsewhere
JWT_SECRET=<generated>
AUTH_OTP_HASH_KEY=<generated>
ID_CARD_CRYPTO_KEY=<generated>
ID_CARD_CRYPTO_INDEX_KEY=<generated>
ACQUISITION_HASH_KEY=<generated>

# Proxy trust (W35a plan D-3): getRemoteAddr() is the real client only behind Caddy. The address is Caddy's fixed address
# in docker/test-env/compose.yaml (a Java regular expression, so the dots are escaped); change both together. Without
# these two lines every client shares Caddy's rate-limit bucket.
SERVER_FORWARD_HEADERS_STRATEGY=native
SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES='172\.30\.0\.10'

# Survey photo upload stays off (W35a plan D-7): no store, scanner or processor runs on the VM
APP_SURVEY_MEDIA_UPLOADENABLED=false
APP_SURVEY_MEDIA_STORE=none
APP_SURVEY_MEDIA_SCANNER=none
APP_SURVEY_MEDIA_PROCESSOR_KIND=none
