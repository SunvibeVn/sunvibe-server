# Auth mail through Brevo SMTP in production. A template without secrets: scripts/ops/README.md section 9 explains the mail values.
# Set these in the deployment system. Never commit a filled copy. Opening production is the owner's act.
# <ref: name> is the name of an entry in the secret store of the environment, not its value.

SPRING_PROFILES_ACTIVE=prod

# SMTP relay; every auth mail goes through it. Unset, MAIL_HOST falls back to another provider, which would get the key.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
# Keep true: it makes TLS mandatory before the login is sent
MAIL_STARTTLS=true
# The sender shown on every mail; it must be a verified Brevo sender. It is not the SMTP login.
MAIL_FROM=services@sunvibe.vn
# The SMTP login of the Brevo account, copied from its SMTP settings page
MAIL_USERNAME=<ref: production/brevo-smtp-login>
# An SMTP key made for this environment alone; not an API key and not the password of the account
MAIL_PASSWORD=<ref: production/brevo-smtp-key>
# Per process, an hourly figure under the limit of the plan: README section 9, step 5. Not a number yet: start-up fails until
# it is one.
AUTH_MAIL_MAX_PER_HOUR=<hourly figure under the limit of the approved plan>

# The web app; reset links start with it. APP_CORS_ALLOWED_ORIGINS stays unset here: application-prod.yml holds the
# allow-list, so another host on this line stops the start-up.
AUTH_FRONTEND_BASE_URL=https://www.sunvibe.vn

# Same value as NEXT_PUBLIC_AUTH_PHONE_MODE in the web build; legacy-login also needs AUTH_PHONE_LEGACY_LOGIN_UNTIL
AUTH_PHONE_MODE=off

# The rest of what the profile prod needs to start; each key belongs to this environment alone
DB_URL=<ref: production/db-url>
DB_USERNAME=<ref: production/db-username>
DB_PASSWORD=<ref: production/db-password>
JWT_SECRET=<ref: production/jwt-secret>
AUTH_OTP_HASH_KEY=<ref: production/otp-hash-key>
ID_CARD_CRYPTO_KEY=<ref: production/id-card-key>
ID_CARD_CRYPTO_INDEX_KEY=<ref: production/id-card-index-key>
ACQUISITION_HASH_KEY=<ref: production/acquisition-hash-key>
